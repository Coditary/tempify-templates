#!/bin/sh
# Publish the "{{ template_id }}" template to the Tempify registry.
# Opens a "register template" issue in the registry repository via GitHub CLI.
# Generated by Tempify tempify-tpl-project (build_system={{ build_system }}).

set -eu

TEMPLATE_ID="{{ template_id }}"
TEMPLATE_NAME="{{ template_name }}"
TEMPLATE_VERSION="{{ template_version }}"
TEMPLATE_DESCRIPTION="{{ template_description }}"
TEMPLATE_TAGS="{{ template_tags }}"
AUTHOR="{{ author }}"
REGISTRY_REPO="${REGISTRY_REPO:-{{ registry_repo }}}"

if [ ! -f template.lua ]; then
  echo "error: run from the template root (template.lua not found)." >&2
  exit 1
fi

TAGS_JSON=$(printf '%s' "$TEMPLATE_TAGS" \
  | tr ',' '\n' \
  | sed -e 's/^ *//' -e 's/ *$//' -e '/^$/d' -e 's/.*/"&"/' \
  | paste -sd, -)

ENTRY=$(cat <<EOF
{
  "id": "$TEMPLATE_ID",
  "name": "$TEMPLATE_NAME",
  "description": "$TEMPLATE_DESCRIPTION",
  "version": "$TEMPLATE_VERSION",
  "tags": [$TAGS_JSON],
  "source": {
    "type": "git",
    "url": "git+https://github.com/Coditary/Tempify-Templates.git",
    "ref": "main",
    "subdir": "$TEMPLATE_ID"
  }
}
EOF
)

TITLE="Register template: $TEMPLATE_ID@$TEMPLATE_VERSION"

BODY=$(cat <<EOF
## Template registration request

| Field | Value |
|-------|-------|
| ID | \`$TEMPLATE_ID\` |
| Name | $TEMPLATE_NAME |
| Version | $TEMPLATE_VERSION |
| Author | ${AUTHOR:-unknown} |

$TEMPLATE_DESCRIPTION

### Registry entry

\`\`\`json
$ENTRY
\`\`\`

Please add this file to the registry:

\`registry/$(printf '%s' "$TEMPLATE_ID" | cut -c1)/$TEMPLATE_ID.json\`

Then run \`scripts/build-catalog.sh\` to refresh \`templates.json\`.

---
Created by \`scripts/publish.sh\` (Tempify tempify-tpl-project).
EOF
)

print_manual_hint() {
  echo "---" >&2
  echo "Open the issue manually:" >&2
  echo "  https://github.com/$REGISTRY_REPO/issues/new" >&2
  echo >&2
  echo "Title: $TITLE" >&2
  echo >&2
  printf '%s\n' "$BODY" >&2
}

if [ "${PUBLISH_DRY_RUN:-0}" = "1" ]; then
  echo "Title: $TITLE"
  echo
  printf '%s\n' "$BODY"
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "error: GitHub CLI 'gh' not found — cannot create the registry issue." >&2
  print_manual_hint
  exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
  echo "error: GitHub CLI is not authenticated (run: gh auth login)." >&2
  print_manual_hint
  exit 1
fi

if gh issue create --repo "$REGISTRY_REPO" --title "$TITLE" --body "$BODY"; then
  echo "Registry issue created in $REGISTRY_REPO."
else
  echo "error: failed to create the registry issue." >&2
  print_manual_hint
  exit 1
fi
