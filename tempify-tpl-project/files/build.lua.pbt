-- Build automation for the "{{ template_name }}" Tempify template.
-- Generated by Tempify tempify-tpl-project (build_system=beez).

local TEMPIFY = beez.env_or("TEMPIFY", "tempify")

step({
    name = "validate",
    phase = "check",
    scope = "template",
    description = "Validate template structure",
    run = TEMPIFY .. " validate .",
})

step({
    name = "lint",
    phase = "check",
    scope = "template",
    description = "Lint template quality",
    run = TEMPIFY .. " lint .",
})

step({
    name = "fixtures",
    phase = "test",
    scope = "template",
    description = "Run template snapshot fixtures",
    run = TEMPIFY .. " test .",
})

step({
    name = "update-snapshots",
    phase = "test",
    scope = "snapshots",
    description = "Regenerate fixture snapshots after intentional changes",
    run = TEMPIFY .. " test . --update-snapshots",
})

step({
    name = "publish",
    phase = "publish",
    scope = "registry",
    description = "Open registry issue in {{ registry_repo }}",
    run = "sh scripts/publish.sh",
})

-- Default entry point: standard checks, then snapshot tests.
workflow("all", {
    { phase = "check", scope = "template" },
    { phase = "test", scope = "template" },
})

workflow("check", {
    { phase = "check", scope = "template" },
})

workflow("test", {
    { phase = "test", scope = "template" },
})

-- Publish: re-run checks + tests, then open the registry issue.
workflow("publish", {
    { phase = "check", scope = "template" },
    { phase = "test", scope = "template" },
    { phase = "publish", scope = "registry" },
})
