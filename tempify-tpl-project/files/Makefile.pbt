# Build automation for the "{{ template_name }}" Tempify template.
# Generated by Tempify tempify-tpl-project (build_system=make).

TEMPIFY ?= tempify

.PHONY: all check validate lint test update-snapshots publish

# Default: standard checks, then snapshot tests.
all: check test

check: validate lint

validate:
	$(TEMPIFY) validate .

lint:
	$(TEMPIFY) lint .

test:
	$(TEMPIFY) test .

update-snapshots:
	$(TEMPIFY) test . --update-snapshots

# Publish: re-run tests, then open a registry issue in {{ registry_repo }}.
publish: test
	sh scripts/publish.sh
